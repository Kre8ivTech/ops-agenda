{
  "name": "ops-agenda",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered SaaS that turns email and calendar data into structured, actionable daily and weekly agendas.",
  "author": "Jeremiah Castillo <info@kre8ivtech.com>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kre8ivTech/ops-agenda.git"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @ops-agenda/web dev",
    "build": "pnpm --filter @ops-agenda/web build",
    "start": "pnpm --filter @ops-agenda/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @ops-agenda/web test:watch",
    "test:coverage": "pnpm --filter @ops-agenda/web test:coverage",
    "test:e2e": "pnpm --filter @ops-agenda/web test:e2e",
    "test:e2e:ui": "pnpm --filter @ops-agenda/web test:e2e:ui",
    "test:rls": "pnpm --filter @ops-agenda/web test:rls",
    "db:generate": "pnpm --filter @ops-agenda/web db:generate",
    "db:migrate": "pnpm --filter @ops-agenda/web db:migrate",
    "db:push": "pnpm --filter @ops-agenda/web db:push",
    "db:studio": "pnpm --filter @ops-agenda/web db:studio",
    "synth": "pnpm --filter @ops-agenda/infra synth",
    "cdk:synth": "pnpm --filter @ops-agenda/infra synth",
    "cdk:diff": "pnpm --filter @ops-agenda/infra diff",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
