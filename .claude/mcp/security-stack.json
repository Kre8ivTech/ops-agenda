{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/mcp-config.json",
  "description": "MCP servers for security auditing and quality assurance",
  "mcpServers": {
    "sonarqube": {
      "command": "npx",
      "args": ["-y", "sonarqube-mcp-server"],
      "env": {
        "SONAR_HOST_URL": "${SONAR_HOST_URL}",
        "SONAR_TOKEN": "${SONAR_TOKEN}",
        "SONAR_PROJECT_KEY": "${SONAR_PROJECT_KEY}"
      },
      "description": "Code quality analysis and security scanning"
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "${SENTRY_ORG}",
        "SENTRY_PROJECT": "${SENTRY_PROJECT}"
      },
      "description": "Error tracking and monitoring"
    },
    "snyk": {
      "command": "npx",
      "args": ["-y", "snyk-mcp-rest"],
      "env": {
        "SNYK_TOKEN": "${SNYK_TOKEN}"
      },
      "description": "Dependency vulnerability scanning"
    }
  }
}
