{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/mcp-config.json",
  "description": "MCP servers for DevOps and infrastructure management",
  "mcpServers": {
    "docker": {
      "command": "npx",
      "args": ["-y", "docker-mcp"],
      "description": "Docker container management"
    },
    "aws": {
      "command": "npx",
      "args": ["-y", "@aws/mcp"],
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}"
      },
      "description": "AWS cloud resource management"
    },
    "cloudflare": {
      "command": "npx",
      "args": ["-y", "cloudflare-api-mcp"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "${CLOUDFLARE_ACCOUNT_ID}"
      },
      "description": "Cloudflare Workers, D1, R2, KV management"
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "vercel-api-mcp"],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}"
      },
      "description": "Vercel deployment management"
    }
  }
}
