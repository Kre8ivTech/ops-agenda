{
  "name": "@ops-agenda/web",
  "version": "0.1.0",
  "private": true,
  "description": "Ops Agenda Next.js web application",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rls": "vitest run src/lib/db/rls",
    "db:generate": "drizzle-kit generate",
