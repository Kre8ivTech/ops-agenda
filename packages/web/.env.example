# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=local-dev-session-secret-min-32-chars!!

# Local dashboard preview without Cognito (development only)
AUTH_DEV_BYPASS=true

# Cognito (required for signup / forgot-password / Hosted UI sign-in)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# Comma-separated allowlist for self-serve signup (required to create accounts)
SIGNUP_ACCESS_CODES=dev-access-2026

# Optional
# DATABASE_URL=
# AUDIT_BUCKET_NAME=
# SYNC_QUEUE_URL=
# SKIP_ENV_VALIDATION=true
