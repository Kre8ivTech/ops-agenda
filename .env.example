# Example Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=MyApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# =============================================================================
# DATABASE
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myapp
DB_USERNAME=myapp
DB_PASSWORD=secret

# =============================================================================
# GITHUB
# =============================================================================
# Required for GitHub MCP server
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SUPABASE
# =============================================================================
# Required for Supabase MCP server
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx

# =============================================================================
# FIGMA
# =============================================================================
# Required for Figma MCP server
# Create at: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxx

# =============================================================================
# NOTION
# =============================================================================
# Required for Notion MCP server
# Create at: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxx

# =============================================================================
# PROJECT MANAGEMENT
# =============================================================================
# Linear (https://linear.app/settings/api)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxx

# Jira (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_HOST=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=xxxxxxxxxxxx

# =============================================================================
# SECURITY & QUALITY
# =============================================================================
# SonarQube
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=sqp_xxxxxxxxxxxx
SONAR_PROJECT_KEY=your-project-key

# Sentry (https://sentry.io/settings/account/api/auth-tokens/)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# Snyk (https://app.snyk.io/account)
SNYK_TOKEN=xxxxxxxxxxxx

# =============================================================================
# CLOUD PROVIDERS
# =============================================================================
# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx

# Cloudflare (https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxx

# Vercel (https://vercel.com/account/tokens)
VERCEL_TOKEN=xxxxxxxxxxxx

# =============================================================================
# AUTHENTICATION (CLERK)
# =============================================================================
# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# =============================================================================
# PAYMENTS (STRIPE)
# =============================================================================
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# =============================================================================
# API TESTING
# =============================================================================
# Postman (https://web.postman.co/settings/me/api-keys)
POSTMAN_API_KEY=PMAK-xxxxxxxxxxxx

# =============================================================================
# NOTES
# =============================================================================
# - Never commit actual values to version control
# - Use a secrets manager in production
# - Rotate keys regularly
# - Use principle of least privilege
