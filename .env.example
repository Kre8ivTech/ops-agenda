# Ops Agenda — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=OpsAgenda
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/ops_agenda

# =============================================================================
# MICROSOFT 365 (Graph API)
# =============================================================================
# Required for M365 email and calendar sync
# Create at: https://portal.azure.com > App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft

# =============================================================================
# AI / LLM PROVIDER
# =============================================================================
# Required for priority classification, due-out detection, narrative generation
# Choose one provider and set the appropriate key:
AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# =============================================================================
# AUTHENTICATION
# =============================================================================
# NextAuth.js / Auth.js secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# PAYMENTS (STRIPE)
# =============================================================================
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# =============================================================================
# GITHUB
# =============================================================================
# Required for GitHub MCP server
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# =============================================================================
# SECURITY & QUALITY (Optional)
# =============================================================================
# SonarQube
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=sqp_xxxxxxxxxxxx
SONAR_PROJECT_KEY=ops-agenda

# Sentry (https://sentry.io/settings/account/api/auth-tokens/)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx
SENTRY_ORG=kre8ivtech
SENTRY_PROJECT=ops-agenda

# =============================================================================
# DESIGN (Optional)
# =============================================================================
# Figma (https://www.figma.com/developers/api#access-tokens)
FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxx

# =============================================================================
# NOTES
# =============================================================================
# - Never commit actual values to version control
# - Use a secrets manager in production
# - Rotate keys regularly
# - Use principle of least privilege
# - Microsoft Graph scopes: Mail.Read, Calendars.Read only
