# Ops Agenda — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=OpsAgenda
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DATABASE — Supabase (PostgreSQL)
# =============================================================================
# Supabase project (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres:[password]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# =============================================================================
# MICROSOFT 365 (Graph API)
# =============================================================================
# Required for M365 email and calendar sync
# Create at: https://portal.azure.com > App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft

# =============================================================================
# AI / LLM PROVIDER — OpenAI
# =============================================================================
# Required for priority classification, due-out detection, narrative generation
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# =============================================================================
# AUTHENTICATION
# =============================================================================
# NextAuth.js / Auth.js secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# PAYMENTS (STRIPE)
# =============================================================================
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# =============================================================================
# BACKGROUND JOBS — Inngest
# =============================================================================
# Inngest (https://www.inngest.com/dashboard)
INNGEST_EVENT_KEY=xxxxxxxxxxxx
INNGEST_SIGNING_KEY=signkey-xxxxxxxxxxxx

# =============================================================================
# CACHING — Upstash Redis
# =============================================================================
# Upstash (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# =============================================================================
# GITHUB
# =============================================================================
# Required for GitHub MCP server
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# =============================================================================
# ENCRYPTION
# =============================================================================
# Field-level encryption key (AES-256-GCM) for sensitive database columns
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See: setup/docs/SECURITY_ARCHITECTURE.md Section 2.3
ENCRYPTION_KEY=

# =============================================================================
# SECURITY & QUALITY (Optional)
# =============================================================================
# SonarQube
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=sqp_xxxxxxxxxxxx
SONAR_PROJECT_KEY=ops-agenda

# Sentry (https://sentry.io/settings/account/api/auth-tokens/)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx
SENTRY_ORG=kre8ivtech
SENTRY_PROJECT=ops-agenda

# =============================================================================
# DESIGN (Optional)
# =============================================================================
# Figma (https://www.figma.com/developers/api#access-tokens)
FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxx

# =============================================================================
# NOTES
# =============================================================================
# - Never commit actual values to version control
# - Use a secrets manager in production
# - Rotate keys regularly
# - Use principle of least privilege
# - Microsoft Graph scopes: Mail.Read, Calendars.Read only
